# Set in your shell; .env files are not automatically loaded.
ADI_DATA_DIR=backend/data/v2
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=3
MIN_RETRIEVAL_SCORE=0.30
MAX_UPLOAD_BYTES=26214400
MAX_CHUNKS=3000
MAX_CONCURRENT_REQUESTS=2
GENERATION_TIMEOUT=120
ADI_API_TOKEN=
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5500,http://localhost:5500
